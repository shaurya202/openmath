# ==========================================
# OpenMath Environment Configuration
# ==========================================

# Port (optional, defaults to 3000)
PORT=3000

# ------------------------------------------
# Provider 1: Local / Cloud Ollama (Recommended)
# ------------------------------------------
# Run OpenMath with your local or cloud Ollama models (e.g., gemma4:31b-cloud, llama3.1)
PROVIDER=ollama
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_HOST=http://localhost:11434

# ------------------------------------------
# Provider 2: Google Gemini (Multimodal)
# ------------------------------------------
# GEMINI_API_KEY=your_key_here

# ------------------------------------------
# Provider 3: OpenAI / OpenRouter / DeepSeek
# ------------------------------------------
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
