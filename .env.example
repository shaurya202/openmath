# ==========================================
# OpenMath Environment Configuration
# ==========================================

# Port (optional, defaults to 3000)
PORT=3000

# ZERO-KEY MODE:
# OpenMath runs 100% out-of-the-box in zero-key offline mode!
# The offline engine solves linear equations, power derivatives,
# and matches our rich benchmark corpus across calculus & algebra.

# OPTIONAL: Cloud Multimodal AI Providers
# (Provide one or both to enable cloud reasoning & vision)

# Google Gemini API Key (Gemini 1.5 Pro / Flash)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI / OpenRouter / DeepSeek / Ollama
# Get a key at https://platform.openai.com/ or https://openrouter.ai/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
